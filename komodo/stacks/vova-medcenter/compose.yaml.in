services:
  db:
    image: postgres:16
    container_name: vova-medcenter-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: medcenters
      POSTGRES_USER: medcenters
      POSTGRES_PASSWORD: medcenters
    volumes:
      - vova-medcenter-postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U medcenters -d medcenters"]
      interval: 5s
      timeout: 5s
      retries: 30

  backend:
    image: @@BACKEND_IMAGE@@
    pull_policy: build
    build:
      context: .
      dockerfile_inline: |
        FROM vova-medcenter-backend:5f694c6-offline-overlay
        LABEL org.opencontainers.image.revision="@@BACKEND_REVISION@@"
        LABEL space.ravil.vova-medcenter.overlay-sha256="@@BACKEND_OVERLAY_SHA256@@"
        COPY @@BACKEND_DELETE_SCRIPT@@ /tmp/apply-overlay-deletions.sh
        COPY @@BACKEND_ARCHIVE@@ /tmp/backend-overlay.tar.gz.b64
        RUN sh /tmp/apply-overlay-deletions.sh \
            && python -c "import base64,pathlib,tarfile; p=pathlib.Path('/tmp/backend-overlay.tar.gz.b64'); t=pathlib.Path('/tmp/backend-overlay.tar.gz'); t.write_bytes(base64.b64decode(p.read_bytes())); tarfile.open(t).extractall('/', filter='data'); p.unlink(); t.unlink()" \
            && rm -f /tmp/apply-overlay-deletions.sh
    container_name: vova-medcenter-backend
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql+psycopg://medcenters:medcenters@db:5432/medcenters
      FRONTEND_ORIGIN: https://vova-medcenter.ravil.space
      PUBLIC_FRONTEND_ORIGIN: https://vova-medcenter.ravil.space
      GENERATED_DOCUMENTS_DIR: /app/storage/generated
    volumes:
      - vova-medcenter-generated:/app/storage/generated
    labels:
      - "traefik.enable=false"

  frontend:
    image: @@FRONTEND_IMAGE@@
    pull_policy: build
    build:
      context: .
      dockerfile_inline: |
        FROM vova-medcenter-frontend:5f694c6-offline-overlay
        LABEL org.opencontainers.image.revision="@@FRONTEND_REVISION@@"
        LABEL space.ravil.vova-medcenter.overlay-sha256="@@FRONTEND_OVERLAY_SHA256@@"
        COPY @@FRONTEND_DELETE_SCRIPT@@ /tmp/apply-overlay-deletions.sh
        COPY @@FRONTEND_ARCHIVE@@ /tmp/frontend-overlay.tar.gz.b64
        RUN sh /tmp/apply-overlay-deletions.sh \
            && base64 -d /tmp/frontend-overlay.tar.gz.b64 > /tmp/frontend-overlay.tar.gz \
            && tar -xzf /tmp/frontend-overlay.tar.gz -C / \
            && rm -f /tmp/apply-overlay-deletions.sh /tmp/frontend-overlay.tar.gz.b64 /tmp/frontend-overlay.tar.gz
    container_name: vova-medcenter-frontend
    restart: unless-stopped
    depends_on:
      - backend
    networks:
      - default
      - traefik
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.vova-medcenter.rule=Host(`vova-medcenter.ravil.space`)"
      - "traefik.http.routers.vova-medcenter.entrypoints=websecure"
      - "traefik.http.routers.vova-medcenter.tls.certresolver=cloudflare"
      - "traefik.http.services.vova-medcenter.loadbalancer.server.port=80"
      - "traefik.docker.network=traefik_default"

volumes:
  vova-medcenter-postgres:
  vova-medcenter-generated:

networks:
  traefik:
    external: true
    name: traefik_default
